{
  "worktreeHooks": {
    "post_creation": {
      "command": "git pull origin \"${CCMANAGER_BASE_BRANCH:-main}\" && cp \"$CCMANAGER_GIT_ROOT/.env\" .env 2>/dev/null || true",
      "enabled": true
    }
  },
  "worktree": {
    "autoDirectory": true,
    "autoDirectoryPattern": "../{project}-{branch}",
    "copySessionData": true,
    "sortByLastSession": false,
    "autoUseDefaultBranch": false,
    "includeRemoteBranches": false
  }
}
